{
    "name": "uskur/omnipay-pelecard",
    "description": "Pelecard support for Omnipay payment processing library",
    "keywords": [
        "omnipay",
        "pelecard"
    ],
    "homepage": "https://github.com/uskur/omnipay-pelecard",
    "license": "MIT",
    "authors": [
        {
            "name": "Burak USGURLU",
            "email": "burak@uskur.com.tr",
            "homepage": "https://www.uskur.com.tr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "omnipay/common": "^3.0",
        "php-http/guzzle7-adapter": "^1.1"
    },
    "require-dev": {
        "omnipay/tests": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Omnipay\\Pelecard\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "League\\Pelecard\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev"
        }
    }
}
